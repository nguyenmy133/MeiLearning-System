# ============================================================================
# MeiLearning Backend — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# For Spring Boot, set these as system environment variables or in your IDE.
# ============================================================================

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=meilearning
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
# ⚠️ PRODUCTION: Generate a strong secret:  openssl rand -base64 64
JWT_SECRET=your_base64_encoded_secret_here_min_64_chars
JWT_EXPIRATION_MS=86400000

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=INFO

# ── JPA ───────────────────────────────────────────────────────────────────────
# ⚠️ PRODUCTION: use "validate" or "none" instead of "update"
DDL_AUTO=update
SHOW_SQL=true

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# ⚠️ Dùng App Password — KHÔNG phải mật khẩu Gmail thường!
# Hướng dẫn tạo App Password:
#   1. Vào https://myaccount.google.com/security
#   2. Bật "Xác minh 2 bước" (2-Step Verification)
#   3. Vào "Mật khẩu ứng dụng" (App passwords)
#   4. Tạo password mới → copy vào MAIL_PASSWORD
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=your-email@gmail.com

# ── SMS (SpeedSMS) ───────────────────────────────────────────────────────────
# Đăng ký: https://connect.speedsms.vn → Settings → Profile → lấy API Token
SPEEDSMS_API_KEY=your_speedsms_api_token_here
SPEEDSMS_SENDER=Notify
SPEEDSMS_TYPE=2
SPEEDSMS_MAX_PER_DAY=3

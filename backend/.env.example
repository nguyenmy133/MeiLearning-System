# ============================================================================
# MeiLearning Backend — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# For Spring Boot, set these as system environment variables or in your IDE.
# ============================================================================

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=meilearning
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
# ⚠️ PRODUCTION: Generate a strong secret:  openssl rand -base64 64
JWT_SECRET=your_base64_encoded_secret_here_min_64_chars
JWT_EXPIRATION_MS=86400000

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=INFO

# ── JPA ───────────────────────────────────────────────────────────────────────
# ⚠️ PRODUCTION: use "validate" or "none" instead of "update"
DDL_AUTO=update
SHOW_SQL=true

# ============================================================================
# MeiLearning System — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your production values.
# Docker Compose will auto-read .env from the same directory.
# ============================================================================

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5433
DB_NAME=meilearning
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Generate a strong random secret for production!
JWT_SECRET=CHANGE_ME_base64_encoded_secret
JWT_EXPIRATION_MS=86400000

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://your-domain.com

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://your-domain.com:8080/api/v1

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=INFO

# ── JPA ──────────────────────────────────────────────────────────────────────
# ⚠️ PRODUCTION: use "validate" or "none" instead of "update"
DDL_AUTO=validate
SHOW_SQL=false

# ── Email (Gmail SMTP) ──────────────────────────────────────────────────────
# ⚠️ Use App Password, NOT your Gmail password!
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=your-email@gmail.com

# ── SMS (SpeedSMS) ──────────────────────────────────────────────────────────
SPEEDSMS_API_KEY=CHANGE_ME
SPEEDSMS_SENDER=Notify
SPEEDSMS_TYPE=2
SPEEDSMS_MAX_PER_DAY=3

# ── Zalo ─────────────────────────────────────────────────────────────────────
ZALO_ENABLED=false
ZALO_APP_ID=CHANGE_ME
ZALO_APP_SECRET=CHANGE_ME
ZALO_OA_ID=CHANGE_ME
ZALO_REFRESH_TOKEN=
ZALO_ZNS_TEMPLATE_ID=

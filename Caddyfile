# ============================================================================
# MeiLearning System — Caddy Reverse Proxy
# ============================================================================
# Entry point duy nhất. Routing tất cả traffic tới frontend & backend.
# Khi có domain thật, set DOMAIN=meilearning.com trong .env
# → Caddy tự động lấy cert HTTPS từ Let's Encrypt.
# ============================================================================

{$DOMAIN} {
    # ── Reverse Proxy: API ──────────────────────────────────────────
    handle /api/* {
        reverse_proxy backend:8080
    }

    # ── Reverse Proxy: Uploaded files ───────────────────────────────
    handle /uploads/* {
        reverse_proxy backend:8080
    }

    # ── Reverse Proxy: Frontend SPA ─────────────────────────────────
    handle {
        reverse_proxy frontend:80
    }

    # ── Compression ─────────────────────────────────────────────────
    encode gzip zstd

    # ── Security Headers ────────────────────────────────────────────
    header {
        X-Content-Type-Options  nosniff
        X-Frame-Options         DENY
        Referrer-Policy         strict-origin-when-cross-origin
        -Server
    }

    # ── Logging ─────────────────────────────────────────────────────
    log {
        output stdout
        format console
    }
}

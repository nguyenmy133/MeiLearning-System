# ============================================================================
# MeiLearning System — Caddy Reverse Proxy
# ============================================================================
# Entry point duy nhất. Routing tất cả traffic tới frontend & backend.
# Khi có domain thật, set DOMAIN=meilearning.com trong .env
# → Caddy tự động lấy cert HTTPS từ Let's Encrypt.
# ============================================================================

{$DOMAIN} {
	# ── Reverse Proxy: API ──────────────────────────────────────────
	handle /api/* {
		reverse_proxy backend:8080
	}

	# ── Reverse Proxy: Uploaded files ───────────────────────────────
	# Cho phép browser render inline (PDF viewer, images) bằng SAMEORIGIN
	handle /uploads/* {
		reverse_proxy backend:8080
		header {
			X-Frame-Options         "SAMEORIGIN"
			Content-Security-Policy "frame-ancestors 'self'"
			# Cho phép browser hiển thị file inline thay vì download
			Content-Disposition     "inline"
			X-Content-Type-Options  nosniff
			-Server
		}
	}

	# ── Reverse Proxy: Frontend SPA ─────────────────────────────────
	handle {
		reverse_proxy frontend:80
		header {
			X-Frame-Options        DENY
			X-Content-Type-Options nosniff
			Referrer-Policy        strict-origin-when-cross-origin
			-Server
		}
	}

	# ── Compression ─────────────────────────────────────────────────
	encode gzip zstd

	# ── Common Security Headers ─────────────────────────────────────
	header {
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# ── Logging ─────────────────────────────────────────────────────
	log {
		output stdout
		format console
	}
}
